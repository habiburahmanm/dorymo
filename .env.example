# ==============================================================================
# NexServe // Unified Multi-Service Ecosystem Environment Variables
# ==============================================================================

# 1. SUPABASE CLIENT & BACKEND POSTGRESQL CONFIGURATION
# Obtain these from your Supabase Project Settings -> API
# Deploy subpath (GitHub Pages repo name). Default: /dorymo/
VITE_BASE_PATH=/dorymo/

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Supabase Edge Function Base URL for backend payment webhook dispatch
VITE_PAYMENT_EDGE_FUNCTION_URL=https://your-project-id.supabase.co/functions/v1/payment

# --- MANUAL SIM PAYMENT (v2 checkout) ---
# Your PERSONAL bKash / Nagad numbers shown on the checkout screen.
# Replace the placeholders with your real numbers before going live.
VITE_OWNER_BKASH_NUMBER=01700000000
VITE_OWNER_NAGAD_NUMBER=01900000000

# 2. BANGLADESH LOCAL PAYMENT GATEWAYS

# --- A. bKash Tokenized Checkout (Sandbox & Production) ---
# Obtain from bKash Merchant Portal (https://developer.bka.sh)
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_CALLBACK_URL=http://localhost:5173/api/payment/bkash/callback

# --- B. Nagad Direct Merchant API ---
NAGAD_BASE_URL=http://sandbox.mymoneydigital.com:9080/api/dfs
NAGAD_MERCHANT_ID=your_nagad_merchant_id
NAGAD_PUBLIC_KEY=your_nagad_public_key
NAGAD_PRIVATE_KEY=your_nagad_private_key

# --- C. SSLCommerz Gateway (Multi-Channel Aggregator: Cards, Rocket, Upay, MFS) ---
# Obtain from SSLCommerz Merchant Panel (https://developer.sslcommerz.com)
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_SANDBOX=true
